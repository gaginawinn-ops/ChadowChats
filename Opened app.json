{
  "expo": {
    "name": "ShadowChat",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#08080e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shadowchat.mobile"
    },
    "android": {
      "package": "com.shadowchat.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#08080e"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ShadowChat to access your photos",
          "cameraPermission": "Allow ShadowChat to use your camera"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow ShadowChat to access your microphone"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
